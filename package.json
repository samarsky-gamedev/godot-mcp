  "description": "Educational fork with saved scene inspection and bounded validation by project contributors",
  "keywords": [
    "godot",
    "mcp",
    "ai",
    "claude",
    "cline"
  ],
  "homepage": "https://github.com/Coding-Solo/godot-mcp",
